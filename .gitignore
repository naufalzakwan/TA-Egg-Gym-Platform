# Local Git history backups from the original component repositories.
/.git-history-backup/

# Local environment and credentials.
**/.env
**/.env.*
!**/.env.example
!**/.env.testing
**/google-services.json
**/GoogleService-Info.plist
**/*firebase-service-account*.json
**/*service-account*.json
**/*.jks
**/*.keystore
**/*.key
**/*.pem

# Dependencies and generated build output.
**/vendor/
**/node_modules/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/.gradle/
**/android/local.properties

# Editor and operating-system files.
**/.idea/
**/.vscode/
**/*.iml
**/.DS_Store
**/Thumbs.db

# Runtime-generated Laravel files.
egg_gym_api/storage/logs/*.log
egg_gym_api/storage/framework/cache/data/*
egg_gym_api/storage/framework/sessions/*
egg_gym_api/storage/framework/views/*

# Keep the final application binary submitted to POLNEP.
!Binary/
!Binary/*.apk
